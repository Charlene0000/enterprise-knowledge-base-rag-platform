# Copy this file to .env and fill in private values locally.
# Never commit .env or real API keys.

# ---------- Unified application ----------
# standalone: no key/GPU/database required; full: original LangGraph production path.
APP_NAME=Zhiku Enterprise RAG
APP_VERSION=1.0.0
APP_MODE=standalone
APP_ENV=development
LOG_LEVEL=INFO
SEED_STANDALONE_DATA=True
STANDALONE_DATA_DIR=./examples
RUNTIME_DATA_DIR=./data/runtime
DEFAULT_TOP_K=5
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Authentication is off for the local standalone mode. Enable it for deployment.
AUTH_ENABLED=False
JWT_SECRET=development-only-change-me
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=local-admin
ADMIN_PASSWORD=local-password

# ---------- Runtime data ----------
DATA_BASED_ROOT_DIR=./data/tasks
MD_ROOT_DIR=./data/temp-files
MODELSCOPE_CACHE=./data/models/modelscope
HF_HOME=./data/models/huggingface
MODELSCOPE_OFFLINE=0
MINERU_MODEL_SOURCE=modelscope

# ---------- MinerU PDF parsing ----------
# Example for the current MinerU batch API; verify against your account's API docs.
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# ---------- OpenAI-compatible LLM ----------
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen3-vl-flash
ITEM_MODEL=qwen-flash

# ---------- BGE-M3 embedding ----------
# A ModelScope/Hugging Face model ID or an absolute local model path.
BGE_M3_PATH=BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3

# Optional local reranker settings (the current query flow uses DashScope rerank).
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# ---------- Milvus ----------
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ---------- MongoDB ----------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=zhiku

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=zhiku
MINIO_IMG_DIR=images
MINIO_SECURE=False
# Public reads are convenient for the local full-stack environment only. Keep false in production.
MINIO_PUBLIC_READ=False
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ---------- Web search / rerank ----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
