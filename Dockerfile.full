FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_MODE=full \
    APP_ENV=production

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 zhiku \
    && useradd --uid 10001 --gid zhiku --no-create-home --shell /usr/sbin/nologin zhiku

COPY requirements-standalone.txt requirements-full.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement requirements-full.txt

COPY . .
RUN mkdir -p /app/data/runtime /app/data/tasks /app/data/temp-files \
    && chown -R 10001:10001 /app/data

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD curl --fail http://127.0.0.1:8000/health/live || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
